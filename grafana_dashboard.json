          "expr": "sum(rate(weather_fetch_errors_total{service_name=\"weather-collector-chennai\"}[$__rate_interval])) / sum(rate(weather_fetch_total{service_name=\"weather-collector-chennai\"}[$__rate_interval]))",
          "legendFormat": "Error ratio",
          "refId": "A",
          "exemplar": true
        }
      ],
      "title": "Collector — Fetch Error Ratio",
      "type": "timeseries"
    },
