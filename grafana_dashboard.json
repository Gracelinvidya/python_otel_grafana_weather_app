      "description": "Flask request duration percentiles. Exemplar dots on the p99 line jump directly to the slowest traces in Tempo. Exemplar dots carry two drilldown links: ① jump to the Tempo trace waterfall, ② jump to Loki logs filtered by that trace_id.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "seconds",
            "fillOpacity": 5,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "links": [
            {
              "title": "→ Tempo: view trace",
              "url": "/explore?left={\"datasource\":\"${DS_TEMPO}\",\"queries\":[{\"query\":\"${__value.exemplar.traceID}\",\"queryType\":\"traceql\",\"refId\":\"A\",\"datasource\":{\"type\": \"tempo\", \"uid\": \"${DS_TEMPO}\"}}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}"
            },
