              "url": "/explore?left={\"datasource\":\"${DS_TEMPO}\",\"queries\":[{\"query\":\"${__value.exemplar.traceID}\",\"queryType\":\"traceql\",\"refId\":\"A\",\"datasource\":{\"type\": \"tempo\", \"uid\": \"${DS_TEMPO}\"}}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}"
            },
            {
              "title": "→ Loki: logs for this trace",
              "url": "/explore?left={\"datasource\":\"${DS_LOKI}\",\"queries\":[{\"expr\":\"{\\\"service_name\\\":\\\"weather-collector-chennai\\\"} | trace_id = \\\"${__value.exemplar.traceID}\\\"\",\"refId\":\"A\",\"datasource\":{\"type\": \"loki\", \"uid\": \"${DS_LOKI}\"}}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}"
            }
