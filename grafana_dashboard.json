      "pluginName": "Loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Grafana Cloud Traces",
      "description": "Tempo datasource. For full trace→log drilldown, configure this datasource in Grafana with tracesToLogs: datasourceUid=<your-loki-uid>, tags=['service_name'], mappedTags=[{key:'service.name',value:'service_name'}], filterByTraceID=true, filterBySpanID=false, lokiSearch=true.",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
