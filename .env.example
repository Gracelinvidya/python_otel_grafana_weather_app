# ============================================================
# .env.example — safe template, commit this to git
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is gitignored and must never be committed.
# ============================================================

# ── OpenWeatherMap ──────────────────────────────────────────
# Free API key from https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ── Grafana Cloud OTLP ─────────────────────────────────────
# Get these from: your Grafana stack →
#   Connections → Add new connection → OpenTelemetry (OTLP)
# The HEADERS value is a bare base64 token (instanceID:apiToken).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=your_grafana_cloud_token_here
